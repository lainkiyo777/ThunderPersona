{
  "model_name": "Qwen/Qwen2.5-3B-Instruct",
  "train_file": ".wechat-exports/lora/persona.train.jsonl",
  "val_file": ".wechat-exports/lora/persona.val.jsonl",
  "output_dir": ".wechat-exports/lora/output/qwen2.5-3b-persona-qlora",
  "require_cuda": true,
  "load_in_4bit": true,
  "bnb_4bit_quant_type": "nf4",
  "bnb_4bit_compute_dtype": "float16",
  "torch_dtype": "float16",
  "device_map": "auto",
  "max_seq_length": 1024,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "num_train_epochs": 2,
  "logging_steps": 10,
  "eval_steps": 100,
  "save_steps": 100,
  "save_total_limit": 3,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  "fp16": true,
  "bf16": false,
  "gradient_checkpointing": true,
  "report_to": "none",
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ]
}
